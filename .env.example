DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# E-mail (Resend - tier gratuito)
RESEND_API_KEY=
EMAIL_FROM="Escala Igreja <notificacoes@escalaigreja.local>"

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:contato@escala.local"

# WhatsApp (Multi-Provedor: 'meta' | 'evolution' | 'zapi' | 'simulation')
# Padrão: auto-detecção com fallback para simulação se nenhuma credencial for definida
WHATSAPP_PROVIDER=simulation

# Provedor 1: Meta WhatsApp Cloud API (Oficial - Graph API)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v21.0

# Provedor 2: Evolution API (Instância Baileys auto-hospedada)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=escala-igreja

# Provedor 3: Z-API (Provedor nacional)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Rate Limiting Distribuído Serverless (Upstash Redis REST - tier gratuito 10.000 req/dia)
# Se ausente, opera automaticamente em memória local com auto-expurgo anti-DoS
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Autenticação de Cron Jobs
CRON_SECRET= 
