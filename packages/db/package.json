{
  "name": "@revezo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "pnpm --filter @revezo/domain... build && tsx src/seed.ts",
    "build": "prisma generate && tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@revezo/domain": "workspace:*",
    "@prisma/client": "^7.10.1"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
