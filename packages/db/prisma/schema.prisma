// Rascunho inicial. Ajustar e migrar na Fase 1.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // URL com pool (app)
  directUrl = env("DIRECT_URL")     // URL direta (migrations)
}

enum GlobalRole {
  ADMIN_MASTER
  PASTOR
  ELDER
  USER
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

enum DepartmentRole {
  MANAGER
  MEMBER
}

enum AssignmentStatus {
  PENDING_APPROVAL
  PENDING
  CONFIRMED
  DECLINED
  SUBSTITUTED
}

enum SwapStatus {
  PENDING_TARGET
  PENDING_MANAGER
  APPROVED
  REJECTED
  CANCELLED
}

enum AvailabilityKind {
  PREFERRED_WEEKDAY
  UNAVAILABLE_PERIOD
}

enum ChannelName {
  WHATSAPP
  EMAIL
  PUSH
  SMS
}

enum ReminderKind {
  D7
  D2
  D1
  SUBSTITUTION
  OPEN_SLOT
}

enum TokenPurpose {
  PASSWORD_RESET
  CONFIRM_ASSIGNMENT
  EMAIL_VERIFY
  CALENDAR_FEED
}

model ChurchSettings {
  id             Int     @id @default(1)
  name           String
  logoUrl        String?
  primaryColor   String  @default("#1E40AF")
  secondaryColor String  @default("#F59E0B")
}

model Church {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  logoUrl        String?
  primaryColor   String         @default("#1E40AF")
  secondaryColor String         @default("#F59E0B")
  address        Json?
  phone          String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  pastors        PastorChurch[]
  users          User[]
  departments    Department[]
  programs       Program[]
  auditLogs      AuditLog[]
}

model PastorChurch {
  pastorId  String
  churchId  String
  createdAt DateTime @default(now())

  pastor    User     @relation("PastorManagedChurches", fields: [pastorId], references: [id], onDelete: Cascade)
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@id([pastorId, churchId])
  @@index([pastorId])
  @@index([churchId])
}

model User {
  id              String        @id @default(cuid())
  name            String
  email           String        @unique
  passwordHash    String
  globalRole      GlobalRole    @default(USER)
  status          AccountStatus @default(PENDING)
  photoUrl        String?
  birthDate       DateTime?
  gender          String?
  maritalStatus   String?
  phonePrimary    String?       // E.164
  phoneSecondary  String?
  whatsapp        String?
  address         Json?         // rua, número, bairro, cidade, UF, CEP
  emergencyContact Json?
  joinedAt        DateTime?
  preferredChannel ChannelName  @default(WHATSAPP)
  notes           String?
  termsAcceptedAt DateTime?
  termsVersion    String?
  // proteção a voluntários menores de idade (LGPD)
  isMinor          Boolean       @default(false)
  guardianName     String?
  guardianPhone    String?
  guardianConsentAt DateTime?
  // segurança
  failedLogins    Int           @default(0)
  lockedUntil     DateTime?
  mfaEnabled      Boolean       @default(false)
  mfaSecretEnc    String?       // TOTP criptografado (AES-256-GCM)
  mfaRecoveryCodes Json?        // hashes SHA-256 dos códigos de recuperação
  // opt-out por canal
  optOutWhatsapp  Boolean       @default(false)
  optOutEmail     Boolean       @default(false)
  optOutPush      Boolean       @default(false)
  optOutSms       Boolean       @default(true)
  createdAt       DateTime      @default(now())

  // Vínculo e congregação
  churchId        String?
  church          Church?       @relation(fields: [churchId], references: [id])
  pastorChurches  PastorChurch[] @relation("PastorManagedChurches")

  // Ancião vinculado por Pastor ou Admin Master
  appointedById   String?
  appointedBy     User?         @relation("ElderAppointer", fields: [appointedById], references: [id])
  eldersAppointed User[]        @relation("ElderAppointer")

  // Itens criados
  programsCreated    Program[]    @relation("ProgramCreator")
  departmentsCreated Department[] @relation("DepartmentCreator")

  memberships     DepartmentMember[]
  assignments     Assignment[]
  approvedAssignments Assignment[] @relation("AssignmentApprover")
  availabilities  Availability[]
  pushSubscriptions PushSubscription[]
  refreshTokens   RefreshToken[]
  actionTokens    ActionToken[]
  swapRequestsCreated  SwapRequest[] @relation("SwapRequester")
  swapRequestsReceived SwapRequest[] @relation("SwapTarget")
  swapRequestsReviewed SwapRequest[] @relation("SwapReviewer")

  @@index([churchId])
  @@index([churchId, status])
  @@index([status])
  @@index([appointedById])
}

model Department {
  id            String   @id @default(cuid())
  churchId      String?
  name          String
  createdById   String?
  createdByRole GlobalRole?

  church        Church?  @relation(fields: [churchId], references: [id])
  creator       User?    @relation("DepartmentCreator", fields: [createdById], references: [id])

  functions DepartmentFunction[]
  members   DepartmentMember[]
  programs  ProgramDepartment[]
  slots     ProgramSlot[]

  @@unique([churchId, name])
  @@index([churchId])
  @@index([createdById])
}

model DepartmentFunction {
  id           String @id @default(cuid())
  departmentId String
  name         String
  department   Department @relation(fields: [departmentId], references: [id])
  members      MemberFunction[]
  slots        ProgramSlot[]
  @@unique([departmentId, name])
}

model DepartmentMember {
  id           String         @id @default(cuid())
  userId       String
  departmentId String
  role         DepartmentRole @default(MEMBER)
  user         User           @relation(fields: [userId], references: [id])
  department   Department     @relation(fields: [departmentId], references: [id])
  functions    MemberFunction[]
  @@unique([userId, departmentId])
  @@index([departmentId])
}

model MemberFunction {
  memberId   String
  functionId String
  member     DepartmentMember   @relation(fields: [memberId], references: [id])
  function   DepartmentFunction @relation(fields: [functionId], references: [id])
  @@id([memberId, functionId])
  @@index([functionId])
}

model Program {
  id                String             @id @default(cuid())
  churchId          String?
  title             String
  date              DateTime
  clonedFromId      String?
  recurrenceGroupId String?
  createdById       String?
  createdByRole     GlobalRole?

  church        Church?            @relation(fields: [churchId], references: [id])
  creator       User?              @relation("ProgramCreator", fields: [createdById], references: [id])
  departments   ProgramDepartment[]
  slots         ProgramSlot[]

  @@index([churchId, date])
  @@index([date])
  @@index([recurrenceGroupId])
  @@index([createdById])
}

model ProgramDepartment {
  programId    String
  departmentId String
  program      Program    @relation(fields: [programId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  @@id([programId, departmentId])
  @@index([departmentId])
}

model ProgramSlot {
  id            String   @id @default(cuid())
  programId     String
  departmentId  String
  functionId    String?
  title         String   // parte do programa
  startsAt      DateTime
  endsAt        DateTime
  requiredCount Int      @default(1)
  program       Program            @relation(fields: [programId], references: [id])
  department    Department         @relation(fields: [departmentId], references: [id])
  function      DepartmentFunction? @relation(fields: [functionId], references: [id])
  assignments   Assignment[]
  @@index([programId, startsAt])
  @@index([startsAt])
  @@index([departmentId, startsAt])
  @@index([functionId])
}

model Assignment {
  id             String           @id @default(cuid())
  slotId         String
  userId         String
  status         AssignmentStatus @default(PENDING)
  declinedReason String?
  replacedById   String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
  slot           ProgramSlot      @relation(fields: [slotId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
  approver       User?            @relation("AssignmentApprover", fields: [approvedById], references: [id])
  logs           NotificationLog[]
  swapRequests   SwapRequest[]
  @@index([userId, status])
  @@index([slotId])
  @@index([slotId, status])
  @@index([status])
  @@index([approvedById])
}

model Availability {
  id      String           @id @default(cuid())
  userId  String
  kind    AvailabilityKind
  weekday Int?             // 0-6, para PREFERRED_WEEKDAY
  from    DateTime?        // para UNAVAILABLE_PERIOD
  to      DateTime?
  user    User @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([userId, kind])
}

model NotificationLog {
  id           String       @id @default(cuid())
  assignmentId String?
  kind         ReminderKind
  channel      ChannelName
  success      Boolean
  error        String?
  sentAt       DateTime     @default(now())
  assignment   Assignment?  @relation(fields: [assignmentId], references: [id])
  @@index([assignmentId, kind])
}

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  endpoint String @unique
  keys     Json
  user     User   @relation(fields: [userId], references: [id])
  @@index([userId])
}

// ---- Segurança ----

// Refresh tokens do app: só o hash é guardado; rotação com detecção de reuso (família)
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  familyId   String
  tokenHash  String    @unique
  deviceName String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([familyId])
}

// Tokens de uso único (recuperar senha, confirmar presença, assinatura de calendário): só hash
model ActionToken {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  refId     String?      // ex.: assignmentId
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])
  @@index([userId, purpose])
}

// Somente inserção: a aplicação nunca atualiza nem apaga
model AuditLog {
  id         String   @id @default(cuid())
  churchId   String?
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  result     String   // SUCCESS | DENIED | FAILED
  ip         String?
  meta       Json?    // sem dados pessoais completos
  createdAt  DateTime @default(now())

  church     Church?  @relation(fields: [churchId], references: [id])

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([churchId, createdAt])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model SwapRequest {
  id                 String      @id @default(cuid())
  assignmentId       String
  requesterId        String
  targetUserId       String?
  targetAssignmentId String?
  status             SwapStatus  @default(PENDING_TARGET)
  reason             String?
  managerNotes       String?
  reviewedById       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  assignment         Assignment  @relation(fields: [assignmentId], references: [id])
  requester          User        @relation("SwapRequester", fields: [requesterId], references: [id])
  targetUser         User?       @relation("SwapTarget", fields: [targetUserId], references: [id])
  reviewedBy         User?       @relation("SwapReviewer", fields: [reviewedById], references: [id])

  @@index([requesterId])
  @@index([targetUserId])
  @@index([status])
  @@index([assignmentId])
  @@index([reviewedById])
}
