{
  "name": "revezo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @revezo/web dev",
    "build": "pnpm exec turbo run build",
    "build:raw": "pnpm -r --filter=!@revezo/web build && pnpm --filter @revezo/web build",
    "start": "pnpm --filter @revezo/web start",
    "test": "vitest run",
    "test:unit": "vitest run packages/domain/test/scheduling.test.ts packages/domain/test/authz.test.ts packages/domain/test/crypto-and-auth.test.ts packages/domain/test/availability.test.ts packages/domain/test/notifications.test.ts packages/domain/test/overload-detector.test.ts packages/domain/test/auto-scheduler.test.ts packages/domain/test/auto-substitution.test.ts packages/domain/test/member-profile.test.ts packages/domain/test/action-token.test.ts packages/domain/test/menu-and-theme.test.ts packages/domain/test/swap-rules.test.ts packages/domain/test/calendar.test.ts",
    "test:prop": "vitest run packages/domain/test/scheduling.prop.test.ts",
    "test:matrix": "vitest run packages/domain/test/authz-matrix.test.ts",
    "test:concurrency": "vitest run packages/domain/test/concurrency.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:mutation": "pnpm --filter @revezo/domain test:mutation",
    "test:perf": "vitest run packages/domain/test/performance-engine.test.ts apps/web/test/performance-queries-n1.test.ts",
    "typecheck": "pnpm exec turbo run typecheck",
    "lint": "pnpm exec turbo run lint",
    "db:generate": "pnpm --filter @revezo/db generate",
    "db:push": "pnpm --filter @revezo/db push",
    "db:migrate:dev": "pnpm --filter @revezo/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @revezo/db migrate:deploy",
    "db:seed": "pnpm --filter @revezo/db seed",
    "cap:sync": "pnpm --filter @revezo/web cap:sync",
    "cap:open:android": "pnpm --filter @revezo/web cap:open:android",
    "cap:open:ios": "pnpm --filter @revezo/web cap:open:ios"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.10",
    "turbo": "^2.11.6",
    "typescript": "^5.8.2",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "deepmerge-ts": "^8.0.0",
      "qs": "^6.16.0",
      "uuid": "^14.0.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
